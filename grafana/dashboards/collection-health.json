            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "Unobserved",
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Queued health export batches at the selected range end. This signal covers the dedicated Loki exporter."
    },
