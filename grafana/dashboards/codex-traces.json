{
  "uid": "plow-codex-traces",
  "title": "Plow Codex traces",
  "description": "Explore redacted Codex OTLP spans recorded by Tempo. Missing results can reflect partial instrumented coverage or an inactive ingest route.",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "timezone": "utc",
  "time": { "from": "now-2h", "to": "now" },
  "links": [
    {"type": "link", "title": "Find by trace ID", "url": "/d/plow-codex-trace/plow-codex-trace", "keepTime": true},
    {"type": "link", "title": "Activity", "url": "/d/plow-activity/activity", "keepTime": false}
  ],
  "templating": {
    "list": [
      {
        "name": "spanStatus",
        "label": "Span status",
        "type": "custom",
        "description": "Match any span in the trace. A trace can have both OK and Error spans. Unset means the exporter recorded no outcome.",
        "query": "Any status : true, Error : span:status = error, OK : span:status = ok, Unset : span:status = unset",
        "current": { "text": "Any status", "value": "true" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Recent traces",
      "description": "Up to 20 traces in the UTC range. Open a trace ID to inspect its spans. If the search is empty, try Any status or widen the range.",
      "type": "table",
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "plow-tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "plow-tempo" },
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "spss": 1,
          "query": "{ instrumentation:name = \"plow.codex\" && (${spanStatus:raw}) } with (most_recent=true)"
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "minWidth": 100 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
            { "id": "custom.width", "value": 328 },
              { "id": "links", "value": [{ "title": "Open trace", "url": "/d/plow-codex-trace/plow-codex-trace?var-traceId=${__value.raw}&from=${__from}&to=${__to}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Start time" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "canvas",
      "datasource": {
        "type": "datasource",
        "uid": "-- Grafana --"
      },
      "targets": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "inlineEditing": false,
        "panZoom": false,
        "zoomToContent": false,
        "root": {
          "name": "Plow header",
          "type": "frame",
          "background": {
            "color": {
              "fixed": "#392820"
            }
          },
          "elements": [
            {
              "name": "Plow wordmark",
              "type": "rectangle",
              "constraint": {
                "horizontal": "left",
                "vertical": "center"
              },
              "placement": {
                "left": 24,
                "top": 0,
                "width": 112,
                "height": 58
              },
              "background": {
                "image": {
                  "fixed": "plow-cream.png"
                },
                "size": "contain"
              }
            },
            {
              "name": "Codex traces",
              "type": "text",
              "constraint": {
                "horizontal": "leftright",
                "vertical": "center"
              },
              "placement": {
                "left": 156,
                "right": 24,
                "top": 0,
                "height": 28
              },
              "config": {
                "text": {
                  "fixed": "Codex traces"
                },
                "color": {
                  "fixed": "#FFF4DF"
                },
                "size": 20,
                "align": "left",
                "valign": "middle"
              }
            }
          ],
          "border": {
            "color": {
              "fixed": "#6A934F"
            },
            "width": 2
          }
        }
      }
    }
  ]
}
