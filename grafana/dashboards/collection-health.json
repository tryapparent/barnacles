    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retrying and blocked reports",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "plow-collection-status"
      },
      "description": "Count of status reports per interval. A continuing failure can produce multiple reports.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "plow-collection-status"
          },
          "expr": "sum by (collector, lane) (count_over_time({plow_source=\"collector_health\"} | json collector, lane, status | status=~\"retrying|blocked\" [$__interval]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{collector}} · {{lane}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#B64F50"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Live Codex OTLP receipt rate",
      "gridPos": {
        "x": 14,
        "y": 24,
        "w": 10,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
