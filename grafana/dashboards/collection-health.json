{
  "uid": "plow-collection-health",
  "title": "Collection Health",
  "tags": [
    "Plow",
    "Collection"
  ],
  "editable": false,
  "timezone": "utc",
  "schemaVersion": 42,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "type": "marcusolsson-dynamictext-panel",
      "datasource": {"type": "grafana", "uid": "grafana"},
      "targets": [{"refId": "A", "queryType": "snapshot", "snapshot": []}],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "defaultContent": "<div class=\"plow-heading plow-heading--field\"><img class=\"plow-wordmark\" src=\"public/build/plow-cream.png\" alt=\"Plow\"><h1>Collection health</h1></div>",
        "styles": "@font-face { font-family: 'Plow Young Serif'; src: url('public/build/plow-brand/youngserif.woff2') format('woff2'); font-display: swap; }\n& > .dt-row { margin: 0; padding: 0; border: 0; flex: 1; display: flex; }\n.plow-heading { display: flex; align-items: center; flex: 1; gap: 20px; padding: 12px 28px; min-width: 0; color: #FFF4DF; background-color: #1A130D; border: 1px solid #6A934F; border-radius: 3px; }\n.plow-wordmark { width: clamp(92px, 9vw, 128px); height: auto; flex: 0 0 auto; }\n.plow-heading h1 { color: inherit; margin: 0; font: 400 clamp(24px, 2.5vw, 40px) / 1.15 'Plow Young Serif', Georgia, serif; }\n.plow-heading--field { background-image: linear-gradient(90deg, #1A130D 0%, #1A130Ded 30%, #1A130D52 61%, #1A130D00 85%), url('public/build/plow-brand/field.jpg'); background-size: cover; background-position: right 86%; }"
      },
      "transparent": true
    },
    {
      "id": 9,
      "type": "marcusolsson-dynamictext-panel",
      "datasource": {"type": "grafana", "uid": "grafana"},
      "targets": [{"refId": "A", "queryType": "snapshot", "snapshot": []}],
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 2
      },
      "options": {
        "defaultContent": "<p class=\"plow-coverage-note\"><strong>Expected status reports</strong> · T3, Codex history and GitHub · Live and backfill lanes<br>GitHub appears when its collector reports. Widen the range for older reports. Clocks are shown in UTC.</p>",
        "styles": "@font-face { font-family: 'Plow Source Serif'; src: url('public/build/plow-brand/source-serif-4.woff2') format('woff2'); font-display: swap; }\n& > .dt-row { border: 0; margin: 0; padding: 8px 16px; }\n.plow-coverage-note { margin: 0; color: inherit; font: 400 15px / 1.35 'Plow Source Serif', Georgia, serif; }"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Latest report per lane",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "plow-collection-status"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "plow-collection-status"
          },
          "expr": "topk by (collector, scope, lane) (1, max_over_time({plow_source=\"collector_health\"} | json collector, scope, lane, status, observedMs, lastSuccessMs, newestSourceMs, oldestScannedMs, scannedUnits, eligibleUnits, ingestedRecords, unit, gapCode | label_format lastSuccessMs=`{{ default \"Unknown\" .lastSuccessMs }}`, newestSourceMs=`{{ default \"Unknown\" .newestSourceMs }}`, oldestScannedMs=`{{ default \"Unknown\" .oldestScannedMs }}`, scannedUnits=`{{ default \"Unknown\" .scannedUnits }}`, eligibleUnits=`{{ default \"Unknown\" .eligibleUnits }}`, ingestedRecords=`{{ default \"Unknown\" .ingestedRecords }}` | unwrap observedMs | __error__=\"\" [$__range]) by (collector, scope, lane, status, lastSuccessMs, newestSourceMs, oldestScannedMs, scannedUnits, eligibleUnits, ingestedRecords, unit, gapCode))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "oldestScannedMs": true,
              "scannedUnits": true,
              "eligibleUnits": true,
              "ingestedRecords": true,
              "unit": true,
              "gapCode": true
            },
            "indexByName": {
              "collector": 0,
              "scope": 1,
              "lane": 2,
              "status": 3,
              "Value #A": 4,
              "lastSuccessMs": 5,
              "newestSourceMs": 6
            },
            "renameByName": {
              "collector": "Collector",
              "scope": "Scope",
              "lane": "Lane",
              "status": "Last status",
              "Value #A": "Report age",
              "lastSuccessMs": "Last successful read",
              "newestSourceMs": "Newest source"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Last successful read",
                "destinationType": "number"
              },
              {
                "targetField": "Newest source",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Collector",
            "desc": false
          },
          {
            "displayName": "Scope",
            "desc": false
          },
          {
            "displayName": "Lane",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "custom": {
            "minWidth": 72
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Collector"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 126
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "t3": {
                        "text": "T3"
                      },
                      "codex_history": {
                        "text": "Codex history"
                      },
                      "github": {
                        "text": "GitHub"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Scope"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 118
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lane"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 84
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "live": {
                        "text": "Live"
                      },
                      "backfill": {
                        "text": "Backfill"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "working": {
                        "text": "Working"
                      },
                      "idle": {
                        "text": "Idle"
                      },
                      "retrying": {
                        "text": "Retrying"
                      },
                      "blocked": {
                        "text": "Blocked"
                      },
                      "complete": {
                        "text": "Complete"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Report age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 133
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last successful read"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 162
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Newest source"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 162
              }
            ]
          }
        ]
      },
      "description": "Latest report in the selected time range for each collector, scope and lane. Use report age and the collector’s expected cadence to assess freshness. Last successful read can be a poll that found no new records.",
      "links": [
        {
          "title": "View health report history",
          "url": "/d/plow-collection-health/collection-health?viewPanel=11&${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Coverage and progress",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "plow-collection-status"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "plow-collection-status"
          },
          "expr": "topk by (collector, scope, lane) (1, max_over_time({plow_source=\"collector_health\"} | json collector, scope, lane, status, observedMs, lastSuccessMs, newestSourceMs, oldestScannedMs, scannedUnits, eligibleUnits, ingestedRecords, scanProgress, unit, gapCode | label_format lastSuccessMs=`{{ default \"Unknown\" .lastSuccessMs }}`, newestSourceMs=`{{ default \"Unknown\" .newestSourceMs }}`, oldestScannedMs=`{{ default \"Unknown\" .oldestScannedMs }}`, scannedUnits=`{{ default \"Unknown\" .scannedUnits }}`, eligibleUnits=`{{ default \"Unknown\" .eligibleUnits }}`, ingestedRecords=`{{ default \"Unknown\" .ingestedRecords }}` | unwrap observedMs | __error__=\"\" [$__range]) by (collector, scope, lane, status, lastSuccessMs, newestSourceMs, oldestScannedMs, scannedUnits, eligibleUnits, ingestedRecords, scanProgress, unit, gapCode))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "status": true,
              "lastSuccessMs": true,
              "newestSourceMs": true
            },
            "indexByName": {
              "collector": 0,
              "scope": 1,
              "lane": 2,
              "oldestScannedMs": 3,
              "scannedUnits": 4,
              "eligibleUnits": 5,
              "scanProgress": 6,
              "unit": 7,
              "ingestedRecords": 8,
              "gapCode": 9
            },
            "renameByName": {
              "collector": "Collector",
              "scope": "Scope",
              "lane": "Lane",
              "oldestScannedMs": "Oldest scanned",
              "scannedUnits": "Scanned",
              "eligibleUnits": "Eligible",
              "scanProgress": "Progress",
              "unit": "Unit",
              "ingestedRecords": "Ingested",
              "gapCode": "Reported gap"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Oldest scanned",
                "destinationType": "number"
              },
              {
                "targetField": "Scanned",
                "destinationType": "number"
              },
              {
                "targetField": "Eligible",
                "destinationType": "number"
              },
              {
                "targetField": "Ingested",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Collector",
            "desc": false
          },
          {
            "displayName": "Scope",
            "desc": false
          },
          {
            "displayName": "Lane",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "custom": {
            "minWidth": 72
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Collector"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 126
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "t3": {
                        "text": "T3"
                      },
                      "codex_history": {
                        "text": "Codex history"
                      },
                      "github": {
                        "text": "GitHub"
                      }
                    }
