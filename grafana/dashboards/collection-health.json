        },
        "overrides": []
      },
      "description": "Failed log record sends reported since Alloy started. An unobserved counter leaves the number of failed sends unknown."
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Live Codex OTLP spans",
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 3
      },
