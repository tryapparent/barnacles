                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      },
      "description": "Progress is the share of the current eligible inventory scanned. A dash means there is no known positive total or the report predates percentage reporting. Ingested counts are records. Complete means the available authorized history was exhausted. A reported gap can still limit its coverage."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Alloy self-scrape",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "plow-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "plow-mimir"
          },
          "expr": "last_over_time(up{job=\"plow-collection-alloy\"}[45s])",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "Unobserved",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Reporting"
                },
                "0": {
                  "text": "Scrape failed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "A sample in the last 45 seconds at the selected range end shows whether Mimir received Alloy’s self-scrape. Missing samples can mean Alloy or the metrics path is unavailable."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Health export queue",
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "plow-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
