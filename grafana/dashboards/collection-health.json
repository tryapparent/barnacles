          },
          "expr": "last_over_time(otelcol_exporter_queue_size{job=\"plow-collection-alloy\",exporter=~\".*health_loki.*\"}[45s])",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
