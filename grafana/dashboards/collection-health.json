                "value": 118
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lane"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 84
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "live": {
                        "text": "Live"
                      },
                      "backfill": {
                        "text": "Backfill"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest scanned"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Scanned"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 78
              },
              {
