#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if ! command -v node >/dev/null || [ ! -d "$root/node_modules/web-tree-sitter" ]; then
  printf '%s\n' 'pre-commit: install Node 22.18+ and run npm ci --ignore-scripts.' >&2
  exit 1
fi
cd "$root"
node "$root/tooling/check-directory-width.ts"
node "$root/.githooks/check-comments.ts"
exec node "$root/.githooks/check-bend-paths.ts"
