    {
      "id": 9,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Expected status reports** \u00b7 T3, Codex history and GitHub \u00b7 Live and backfill lanes  \nA missing lane has no report in this range. Widen the range to find older reports. Clocks are shown in UTC."
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Latest report per lane",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "plow-collection-status"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "plow-collection-status"
          },
          "expr": "topk by (collector, scope, lane) (1, max_over_time({plow_source=\"collector_health\"} | json collector, scope, lane, status, observedMs, lastSuccessMs, newestSourceMs, oldestScannedMs, scannedUnits, eligibleUnits, ingestedRecords, unit, gapCode | label_format lastSuccessMs=`{{ default \"Unknown\" .lastSuccessMs }}`, newestSourceMs=`{{ default \"Unknown\" .newestSourceMs }}`, oldestScannedMs=`{{ default \"Unknown\" .oldestScannedMs }}`, scannedUnits=`{{ default \"Unknown\" .scannedUnits }}`, eligibleUnits=`{{ default \"Unknown\" .eligibleUnits }}`, ingestedRecords=`{{ default \"Unknown\" .ingestedRecords }}` | unwrap observedMs | __error__=\"\" [$__range]) by (collector, scope, lane, status, lastSuccessMs, newestSourceMs, oldestScannedMs, scannedUnits, eligibleUnits, ingestedRecords, unit, gapCode))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "oldestScannedMs": true,
              "scannedUnits": true,
              "eligibleUnits": true,
              "ingestedRecords": true,
              "unit": true,
              "gapCode": true
            },
            "indexByName": {
              "collector": 0,
              "scope": 1,
              "lane": 2,
              "status": 3,
              "Value #A": 4,
              "lastSuccessMs": 5,
              "newestSourceMs": 6
            },
            "renameByName": {
              "collector": "Collector",
              "scope": "Scope",
              "lane": "Lane",
              "status": "Last status",
              "Value #A": "Report age",
              "lastSuccessMs": "Last success",
              "newestSourceMs": "Newest source"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Last success",
                "destinationType": "number"
              },
              {
                "targetField": "Newest source",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Collector",
            "desc": false
          },
          {
            "displayName": "Scope",
            "desc": false
          },
          {
            "displayName": "Lane",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "custom": {
            "minWidth": 72
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Collector"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 126
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "t3": {
                        "text": "T3"
                      },
                      "codex_history": {
                        "text": "Codex history"
                      },
                      "github": {
                        "text": "GitHub"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Scope"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 118
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lane"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 84
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "live": {
                        "text": "Live"
                      },
                      "backfill": {
                        "text": "Backfill"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "working": {
                        "text": "Working"
                      },
                      "idle": {
                        "text": "Idle"
                      },
                      "retrying": {
                        "text": "Retrying"
                      },
                      "blocked": {
                        "text": "Blocked"
                      },
                      "complete": {
                        "text": "Complete"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Report age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 133
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 162
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Newest source"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 162
              }
            ]
          }
        ]
      },
      "description": "Latest report in the selected time range for each collector, scope and lane. Use report age and the collector\u2019s expected cadence to assess freshness. Last success can be a poll that found no new records.",
      "links": [
        {
          "title": "View health report history",
          "url": "/d/plow-collection-health/collection-health?viewPanel=11&${__url_time_range}",
          "targetBlank": false
        }
      ]
    },
